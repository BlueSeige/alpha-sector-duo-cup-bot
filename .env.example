# Discord bot application (from the Discord Developer Portal)
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
GUILD_ID=your-server-id

# Channel and role IDs
# Enable Developer Mode in Discord (Settings > Advanced), then right click
# a channel or role and choose "Copy ID"
REGISTRATION_CHANNEL_ID=your-registration-channel-id
ADMIN_LOG_CHANNEL_ID=your-admin-log-channel-id
REGISTERED_ROLE_ID=your-registered-role-id
STANDBY_ROLE_ID=your-standby-role-id

# How many teams fit before registrations go to standby
MAX_SLOTS=16

# Optional. Leave all three blank to skip Google Sheets entirely and use
# only the local data/registrations.json file.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
